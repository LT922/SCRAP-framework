# Reference Packmol template: P2-C18 + one mPEG2k-PCL2k chain.
# Run from MD_simulation/MDP_files/.

tolerance 2.0
add_box_sides 2.0

output polymerdrug.pdb

structure ../pairwise_prodrug_polymer_MD/training/P2-C18/mpeg2kpcl2knpt4ns.pdb
  number 1
  inside box 0. 0. 0. 80. 80. 80.
end structure

structure ../pairwise_prodrug_polymer_MD/training/P2-C18/ptx2c18.pdb
  number 1
  inside box 0. 0. 0. 80. 80. 80.
end structure
